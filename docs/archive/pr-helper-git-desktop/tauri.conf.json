{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PR Helper Git",
  "version": "0.6.1",
  "identifier": "com.pr-helper.git",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../server/**/*",
      "../dist"
    ]
  }
}
